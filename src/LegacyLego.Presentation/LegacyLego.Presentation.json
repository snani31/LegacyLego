{
  "openapi": "3.1.1",
  "info": {
    "title": "LegacyLego E-Commerce API",
    "description": "Внутреннее API интернет-магазина конструкторов Lego. Обеспечивает работу с заказами, корзиной и платежными шлюзами.",
    "version": "openapi.v1"
  },
  "paths": {
    "/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "description": "Управление заказами",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/orders/active": {
      "get": {
        "tags": [
          "Orders"
        ],
        "description": "Управление заказами",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/orders/history": {
      "get": {
        "tags": [
          "Orders"
        ],
        "description": "Управление заказами",
        "parameters": [
          {
            "name": "Cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "description": "Управление заказами",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/mock/api/webhooks/payment": {
      "post": {
        "tags": [
          "Payments"
        ],
        "description": "Тестировочные эндпоинты оплаты заказа",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentProviderWebhookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessPaymentDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/mock/{orderId}/pay": {
      "post": {
        "tags": [
          "Payments"
        ],
        "description": "Тестировочные эндпоинты оплаты заказа",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartPaymentResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "required": [
          "currencyCode",
          "orderAddress",
          "items"
        ],
        "type": "object",
        "properties": {
          "currencyCode": {
            "type": "string"
          },
          "orderAddress": {
            "$ref": "#/components/schemas/OrderAddressDto"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          }
        }
      },
      "OrderAddressDto": {
        "required": [
          "country",
          "city",
          "street",
          "postalCode"
        ],
        "type": "object",
        "properties": {
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          }
        }
      },
      "OrderItemDto": {
        "required": [
          "title",
          "quantity",
          "productId",
          "unitPriceAmount"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "unitPriceAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "PaymentProviderWebhookRequest": {
        "required": [
          "externalSessionId",
          "transactionId",
          "orderId",
          "amount",
          "currency",
          "status"
        ],
        "type": "object",
        "properties": {
          "externalSessionId": {
            "type": "string"
          },
          "transactionId": {
            "type": [
              "null",
              "string"
            ]
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProcessPaymentDetails": {
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "currentStatus": {
            "type": [
              "null",
              "string"
            ]
          },
          "stateChanged": {
            "type": "boolean"
          },
          "isWarning": {
            "type": "boolean"
          }
        }
      },
      "StartPaymentResponse": {
        "required": [
          "checkoutUrl",
          "expiresAtUtc"
        ],
        "type": "object",
        "properties": {
          "checkoutUrl": {
            "type": "string"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Orders"
    },
    {
      "name": "Payments"
    }
  ]
}