{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "CommandTimeoutSeconds": 5,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 2,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },

  "OutboxBackgroundWorkerOptions": {
    "TakeRecordsNum": 10,
    "SecondsPeriod": 3
  },

  "Hangfire": {
    "WorkerCount": 2,
    "QueuePollInterval": 2
  },

  "OrderHistory": {
    "PageSize": 10
  },

  "CacheOptions": {
    "OrdersHistoryMinutesTtl": 10,
    "OrderDetailsMinutesTtl": 30,
    "OrderGroupDaysTtl": 1
  },

  "PaymentProviderOptions": {
    "ExpiresAtMinutes": 10,
    "ApiBaseUrl": "http://localhost:5203/",
    "CheckoutPagePath": "mock-checkout.html",
    "WebhookRoute": "mock/api/webhooks/payment"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Expressions", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Conditional",
        "Args": {
          "expression": "not (SourceContext = 'Microsoft.EntityFrameworkCore.Database.Command' and @m like '%OutboxPolling%')",
          "configureSink": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },

      {
        "Name": "Conditional",
        "Args": {
          "expression": "(@l >= 'Warning' or SourceContext like 'LegacyLego%') and not (SourceContext like '%OutboxBackgroundWorker' and @l = 'Information')",
          "configureSink": [
            {
              "Name": "Seq",
              "Args": {
                "serverUrl": "http://localhost:5341"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}