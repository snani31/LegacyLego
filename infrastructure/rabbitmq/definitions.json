{
	"rabbit_version": "3.13.0",
	"users": [
		{
			"name": "Rabbit",
			"password": "RabbitPwd",
			"tags": [
				"administrator"
			]
		}
	],
	"vhosts": [
		{
			"name": "/"
		}
	],
	"permissions": [
		{
			"user": "Rabbit",
			"vhost": "/",
			"configure": ".*",
			"write": ".*",
			"read": ".*"
		}
	],
	"queues": [
		{
			"name": "keycloak-events-queue",
			"vhost": "/",
			"durable": true,
			"auto_delete": false,
			"arguments": {
				"x-dead-letter-exchange": "keycloak-events-dlx"
			}
		},
		{
			"name": "keycloak-events-dlq",
			"vhost": "/",
			"durable": true,
			"auto_delete": false,
			"arguments": {}
		}
	],
	"exchanges": [
		{
			"name": "keycloak-events-dlx",
			"vhost": "/",
			"type": "fanout",
			"durable": true,
			"auto_delete": false,
			"arguments": {}
		}
	],
	"bindings": [
		{
			"source": "amq.topic",
			"vhost": "/",
			"destination": "keycloak-events-queue",
			"destination_type": "queue",
			"routing_key": "KK.EVENT.*.*.*.*.REGISTER",
			"arguments": {}
		},
		{
			"source": "keycloak-events-dlx",
			"vhost": "/",
			"destination": "keycloak-events-dlq",
			"destination_type": "queue",
			"routing_key": "",
			"arguments": {}
		}
	]
}
